{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": { "allowJs": true } }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@gsainfoteam|jose|oauth4webapi|@faker-js)"
  ],
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/../src/$1"
  }
}
