LOG_PATH=./logs

POSTGRES_PASSWORD=password
POSTGRES_USER=potg
POSTGRES_DB=potg
DATABASE_URL=postgresql://potg:password@localhost:5432/potg?schema=public&connect_timeout=300

# 인포팀 계정(IdP). issuer 는 production 또는 staging 입니다.
# docker-compose 가 ACCOUNT_ISSUER 와 IDP_CLIENT_ID 를 admin 빌드 args(VITE_ACCOUNT_*)로도 넘깁니다.
ACCOUNT_ISSUER=production
IDP_CLIENT_ID=CHANGE_TO_YOUR_IDP_CLIENT_ID
IDP_CLIENT_SECRET=CHANGE_TO_YOUR_IDP_CLIENT_SECRET
# 32자 이상. 서비스 access token 서명에 씁니다 (openssl rand -base64 48)
SESSION_SECRET=CHANGE_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS

FIREBASE_PROJECT_ID=gsainfoteam-pot-g
FIREBASE_PRIVATE_KEY=CHANGE_TO_YOUR_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=CHANGE_TO_YOUR_FIREBASE_CLIENT_EMAIL

SLACK_WEBHOOK_URL=CHANGE_TO_YOUR_SLACK_WEBHOOK_URL
